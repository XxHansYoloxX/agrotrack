generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

model Kmetija {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ime       String
  naslov    String?
  davcnaSt  String?  @unique @map("davcna_st")
  kmetSt    String?  @unique @map("kmet_st")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  uporabniki     Uporabnik[]
  parcele        Parcela[]
  stroji         Stroj[]
  delavci        Delavec[]
  repromateriali Repromaterial[]

  @@map("kmetija")
}

model Uporabnik {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kmetijaId String   @map("kmetija_id") @db.Uuid
  ime       String
  priimek   String
  email     String   @unique
  gesloHash String   @map("geslo_hash")
  vloga     String   @default("DELAVEC")
  aktiven   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kmetija       Kmetija        @relation(fields: [kmetijaId], references: [id])
  delovniNalogi DelovniNalog[]

  @@map("uporabnik")
}

model Parcela {
  id        String                                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kmetijaId String                                  @map("kmetija_id") @db.Uuid
  naziv     String
  gmid      String?                                 @unique
  povrsina  Decimal                                 @db.Decimal(10, 4)
  kultura   String?
  meja      Unsupported("geometry(Polygon, 4326)")?
  createdAt DateTime                                @default(now()) @map("created_at")
  updatedAt DateTime                                @updatedAt @map("updated_at")

  kmetija        Kmetija         @relation(fields: [kmetijaId], references: [id])
  kolobarji      Kolobar[]
  analizeTal     AnalizaTal[]
  gnojilniNacrti GnojilniNacrt[]
  delovniNalogi  DelovniNalog[]

  @@map("parcela")
}

model Stroj {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kmetijaId    String   @map("kmetija_id") @db.Uuid
  naziv        String
  tip          String
  znamka       String?
  model        String?
  letnik       Int?
  registracija String?  @unique
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  kmetija    Kmetija       @relation(fields: [kmetijaId], references: [id])
  prikljucki Prikljucek[]
  izvedbe    IzvedbaDela[]

  @@map("stroj")
}

model Prikljucek {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  strojId   String   @map("stroj_id") @db.Uuid
  naziv     String
  tip       String
  znamka    String?
  model     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stroj   Stroj         @relation(fields: [strojId], references: [id])
  izvedbe IzvedbaDela[]

  @@map("prikljucek")
}

model Delavec {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kmetijaId String   @map("kmetija_id") @db.Uuid
  ime       String
  priimek   String
  emso      String?  @unique
  rfidTag   String?  @unique @map("rfid_tag")
  aktiven   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kmetija     Kmetija       @relation(fields: [kmetijaId], references: [id])
  izvedbe     IzvedbaDela[]
  rfidDogodki RfidDogodek[]

  @@map("delavec")
}

model Kolobar {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parcelaId String   @map("parcela_id") @db.Uuid
  leto      Int
  opomba    String?
  createdAt DateTime @default(now()) @map("created_at")

  parcela        Parcela          @relation(fields: [parcelaId], references: [id])
  kolobarPosevki KolobarPosevek[]

  @@unique([parcelaId, leto])
  @@map("kolobar")
}

model KolobarPosevek {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kolobarId  String    @map("kolobar_id") @db.Uuid
  posevek    String
  sorta      String?
  datumSetve DateTime? @map("datum_setve")
  datumZetve DateTime? @map("datum_zetve")
  pridelek   Decimal?  @db.Decimal(10, 2)
  enota      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  kolobar Kolobar @relation(fields: [kolobarId], references: [id])

  @@map("kolobar_posevek")
}

model AnalizaTal {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parcelaId   String   @map("parcela_id") @db.Uuid
  datumVzorca DateTime @map("datum_vzorca")
  laboratorij String?
  ph          Decimal? @db.Decimal(4, 2)
  humus       Decimal? @db.Decimal(5, 2)
  fosfor      Decimal? @db.Decimal(8, 2)
  kalij       Decimal? @db.Decimal(8, 2)
  magnezijev  Decimal? @db.Decimal(8, 2)
  dusik       Decimal? @db.Decimal(8, 2)
  opomba      String?
  createdAt   DateTime @default(now()) @map("created_at")

  parcela        Parcela         @relation(fields: [parcelaId], references: [id])
  gnojilniNacrti GnojilniNacrt[]

  @@map("analiza_tal")
}

model GnojilniNacrt {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parcelaId String   @map("parcela_id") @db.Uuid
  analizaId String?  @map("analiza_id") @db.Uuid
  leto      Int
  kultura   String
  odmerekN  Decimal? @map("odmerek_n") @db.Decimal(8, 2)
  odmerekP  Decimal? @map("odmerek_p") @db.Decimal(8, 2)
  odmerekK  Decimal? @map("odmerek_k") @db.Decimal(8, 2)
  gnojilo   String?
  kolicina  Decimal? @db.Decimal(10, 2)
  enota     String?
  opomba    String?
  createdAt DateTime @default(now()) @map("created_at")

  parcela Parcela     @relation(fields: [parcelaId], references: [id])
  analiza AnalizaTal? @relation(fields: [analizaId], references: [id])

  @@map("gnojilni_nacrt")
}

model DelovniNalog {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parcelaId   String    @map("parcela_id") @db.Uuid
  uporabnikId String    @map("uporabnik_id") @db.Uuid
  naziv       String
  tipDela     String    @map("tip_dela")
  status      String    @default("NACRTOVAN")
  datumOd     DateTime  @map("datum_od")
  datumDo     DateTime? @map("datum_do")
  opomba      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parcela   Parcela       @relation(fields: [parcelaId], references: [id])
  uporabnik Uporabnik     @relation(fields: [uporabnikId], references: [id])
  izvedbe   IzvedbaDela[]
  stroski   Strosek[]

  @@map("delovni_nalog")
}

model IzvedbaDela {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  delovniNalogId String    @map("delovni_nalog_id") @db.Uuid
  delavecId      String    @map("delavec_id") @db.Uuid
  strojId        String?   @map("stroj_id") @db.Uuid
  prikljucekId   String?   @map("prikljucek_id") @db.Uuid
  zacetek        DateTime
  konec          DateTime?
  trajanjMin     Int?      @map("trajanj_min")
  opomba         String?
  createdAt      DateTime  @default(now()) @map("created_at")

  delovniNalog DelovniNalog @relation(fields: [delovniNalogId], references: [id])
  delavec      Delavec      @relation(fields: [delavecId], references: [id])
  stroj        Stroj?       @relation(fields: [strojId], references: [id])
  prikljucek   Prikljucek?  @relation(fields: [prikljucekId], references: [id])

  @@map("izvedba_dela")
}

model Strosek {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  delovniNalogId String   @map("delovni_nalog_id") @db.Uuid
  tipStroska     String   @map("tip_stroska")
  opis           String?
  znesek         Decimal  @db.Decimal(12, 2)
  valuta         String   @default("EUR")
  datum          DateTime
  createdAt      DateTime @default(now()) @map("created_at")

  delovniNalog DelovniNalog @relation(fields: [delovniNalogId], references: [id])

  @@map("strosek")
}

model Repromaterial {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kmetijaId String   @map("kmetija_id") @db.Uuid
  naziv     String
  tip       String
  enota     String
  zalogaKol Decimal  @default(0) @map("zaloga_kol") @db.Decimal(12, 3)
  minZaloga Decimal? @map("min_zaloga") @db.Decimal(12, 3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kmetija Kmetija @relation(fields: [kmetijaId], references: [id])

  @@map("repromaterial")
}

model RfidDogodek {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  delavecId  String   @map("delavec_id") @db.Uuid
  rfidTag    String   @map("rfid_tag")
  tipDogodka String   @map("tip_dogodka")
  lokacija   String?
  cas        DateTime @default(now())

  delavec Delavec @relation(fields: [delavecId], references: [id])

  @@map("rfid_dogodek")
}
